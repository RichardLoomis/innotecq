# Two modes, toggled in the UI. Both are REAL, OpenAI-compatible LLM endpoints
# (LangChain's ChatOpenAI). There is no mock: without these set, chat is off.
# For a clean before/after, point both at the SAME model — the only difference
# should be whether the call goes through the Xenovia proxy.

# "Xenovia": model calls routed through your Xenovia tenant proxy (governed).
XENOVIA_BASE_URL=https://app.xenovia.io/v1
XENOVIA_API_KEY=
XENOVIA_MODEL=

# "Direct": the same model provider, called straight, with no proxy.
DIRECT_BASE_URL=https://api.openai.com/v1
DIRECT_API_KEY=
DIRECT_MODEL=

# Password gate. When set, the console requires this to log in and the API
# withholds everything until authenticated. Set this on any public deployment.
DEMO_PASSWORD=
