# The only per-tenant setting. Point at a Xenovia tenant proxy for the
# governed run, or at any raw OpenAI-compatible endpoint for the ungoverned
# "before" run. Nothing else in the codebase changes between the two.
XENOVIA_BASE_URL=https://app.xenovia.io/v1

# Tenant API key (leave empty if the endpoint does not require one).
XENOVIA_API_KEY=

# Model name as the endpoint expects it.
XENOVIA_MODEL=claude-sonnet-5
