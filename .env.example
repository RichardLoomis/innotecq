# Each agent runs under its own gateway, so endpoints are configured per agent.
# Two modes per agent, toggled in the UI:
#   "Xenovia" (proxy, governed)  -> XENOVIA_<AGENT>_*
#   "Direct"  (no proxy)         -> DIRECT_<AGENT>_*
# AGENT is one of: AP, HELPDESK, SUPPORT, REPORTING.
# All are real, OpenAI-compatible endpoints (LangChain ChatOpenAI). No mock.
# A mode's toggle is disabled for an agent until that agent's *_BASE_URL is set.

# ── Xenovia gateways (proxy mode), one per agent ───────────────────────────
XENOVIA_AP_BASE_URL=
XENOVIA_AP_API_KEY=
XENOVIA_AP_MODEL=

XENOVIA_HELPDESK_BASE_URL=
XENOVIA_HELPDESK_API_KEY=
XENOVIA_HELPDESK_MODEL=

XENOVIA_SUPPORT_BASE_URL=
XENOVIA_SUPPORT_API_KEY=
XENOVIA_SUPPORT_MODEL=

XENOVIA_REPORTING_BASE_URL=
XENOVIA_REPORTING_API_KEY=
XENOVIA_REPORTING_MODEL=

# Optional global fallback, used for any agent whose XENOVIA_<AGENT>_* is unset.
# XENOVIA_BASE_URL=
# XENOVIA_API_KEY=
# XENOVIA_MODEL=

# ── Direct mode (no proxy), same per-agent scheme; all optional ────────────
# DIRECT_AP_BASE_URL=
# DIRECT_AP_API_KEY=
# DIRECT_AP_MODEL=
# ...HELPDESK / SUPPORT / REPORTING...
# Or a single global fallback for every agent's Direct mode:
# DIRECT_BASE_URL=
# DIRECT_API_KEY=
# DIRECT_MODEL=

# ── Access ─────────────────────────────────────────────────────────────────
# Password gate. When set, the console requires this to log in and the API
# withholds everything until authenticated. Set this on any public deployment.
DEMO_PASSWORD=
